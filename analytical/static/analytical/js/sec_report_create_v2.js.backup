/**
 * SEC Report Creator V6 - Dual-Table Drag & Drop with Auto-Grouping
 * Left table: Available samples (click to select, drag to move)
 * Right table: Selected samples with groups (drag handles, movable rows)
 * Features: Auto-grouping for Standards/Blanks, protected group names
 */

// Global state
window.reportCreator = {
    leftTable: null,
    rightTable: null,
    groups: [
        {id: 1, name: 'Default', color: '#0056b3'},
        {id: 2, name: 'Standards', color: '#ffc107'},
        {id: 3, name: 'Blanks', color: '#6c757d'}
    ],
    nextGroupId: 4,
    colorPalette: ['#0056b3', '#28a745', '#dc3545', '#ffc107', '#17a2b8', '#6610f2', '#fd7e14', '#20c997'],
    leftTableGrouped: true, // Track grouping state for left table (starts grouped)
    currentVirtualDomBuffer: 500, // Default buffer for 1000 samples
    currentGroupingEnabled: true // Track whether grouping is enabled (disabled for "All samples")
};

/**
 * Calculate optimal virtualDomBuffer based on sample count
 * Scales buffer size to match dataset size for better performance
 */
function calculateVirtualDomBuffer(sampleCount) {
    if (sampleCount <= 500) {
        return 300;
    } else if (sampleCount <= 1000) {
        return 500;
    } else if (sampleCount <= 1500) {
        return 800;
    } else {
        return 1200; // For "All" samples (1500+)
    }
}

/**
 * Initialize left table (Available Samples)
 * @param {number} virtualDomBuffer - Optional buffer size (defaults to current global value)
 * @param {boolean} enableGrouping - Whether to enable grouping (disabled for "All samples" to avoid scroll issues)
 */
function initLeftTable(virtualDomBuffer = null, enableGrouping = true) {
    console.log('[Creator] Initializing left table...');

    // Use provided buffer or current global value
    const bufferSize = virtualDomBuffer !== null ? virtualDomBuffer : window.reportCreator.currentVirtualDomBuffer;
    console.log(`[Creator] Using virtualDomBuffer: ${bufferSize}, grouping: ${enableGrouping}`);

    window.reportCreator.leftTable = new Tabulator("#samples-table", {
        height: "100%",
        layout: "fitDataStretch",
        placeholder: "No samples available",
        selectable: true, // Enable multi-row selection
        selectableRangeMode: "click", // Allow click-based range selection

        // Virtual DOM mode for all sample counts (no pagination)
        virtualDom: true,
        virtualDomBuffer: bufferSize,
        renderVerticalBuffer: 2000, // Helps with scroll jumping when groups collapsed

        // Conditional grouping - disabled for "All samples" to prevent scroll issues
        groupBy: enableGrouping ? "sample_set_name" : false,
        groupStartOpen: false, // All groups collapsed by default
        groupToggleElement: "header", // Make entire group header clickable to expand/collapse
        groupHeader: function(value, count, data, group) {
            // Simple text format: "Sample Set Name - # samples"
            return `${value || 'No Sample Set'} - ${count} sample${count !== 1 ? 's' : ''}`;
        },
        columns: [
            {
                title: "Sample Name",
                field: "sample_name",
                headerFilter: "input",
                sorter: "string"
            },
            {
                title: "Result ID",
                field: "result_id",
                width: 120,
                hozAlign: "center",
                sorter: "number",
                headerFilter: "input",
                headerFilterPlaceholder: "Search..."
            },
            {
                title: "System",
                field: "system_name",
                headerFilter: "input",
                sorter: "string"
            },
            {
                title: "Sample Set",
                field: "sample_set_name",
                headerFilter: "input",
                sorter: "string"
            },
            {
                title: "Date",
                field: "date_acquired",
                width: 120,
                sorter: "date",
                headerFilter: "input",
                headerFilterPlaceholder: "Filter date...",
                headerFilterFunc: function(headerValue, rowValue, rowData, filterParams) {
                    // Custom filter for date - matches partial strings
                    if (!headerValue) return true;
                    if (!rowValue) return false;

                    const dateStr = new Date(rowValue).toLocaleDateString();
                    return dateStr.toLowerCase().includes(headerValue.toLowerCase());
                },
                formatter: function (cell) {
                    const val = cell.getValue();
                    return val ? new Date(val).toLocaleDateString() : 'N/A';
                }
            }
        ]
    });

    // Add click handler for rows (not group headers)
    window.reportCreator.leftTable.on("rowClick", function(e, row) {
        // Check if this is a data row (not a group header)
        const data = row.getData();
        if (data && data.result_id && !data._isPlaceholder) {
            // Alt+Click = Preview selected samples (or clicked sample if none selected)
            if (e.altKey) {
                const selectedRows = window.reportCreator.leftTable.getSelectedRows();

                // If there are selected rows, preview all of them
                if (selectedRows.length > 0) {
                    const resultIds = selectedRows
                        .map(r => r.getData().result_id)
                        .filter(id => id && !String(id).startsWith('placeholder_'));

                    console.log(`[Creator] Alt+Click - Previewing ${resultIds.length} selected samples`);
                    if (previewModal && resultIds.length > 0) {
                        previewModal.showPreview(resultIds);
                    }
                } else {
                    // No selection, preview just this sample
                    console.log('[Creator] Alt+Click - Previewing single sample:', data.result_id);
                    if (previewModal) {
                        previewModal.showPreview(data.result_id);
                    }
                }
                return;
            }

            // Regular click = Toggle row selection (don't add to report)
            row.toggleSelect();
            console.log('[Creator] Row selection toggled:', data.result_id);
        } else {
            console.log('[Creator] Clicked on non-data row (group header or placeholder)');
        }
    });

    // Add double-click handler for rows to add selected samples to report
    window.reportCreator.leftTable.on("rowDblClick", function(e, row) {
        const data = row.getData();
        if (data && data.result_id && !data._isPlaceholder) {
            const selectedRows = window.reportCreator.leftTable.getSelectedRows();

            // If clicked row is in selection, add all selected samples
            if (selectedRows.includes(row)) {
                console.log(`[Creator] Double-click - Adding ${selectedRows.length} selected samples to report`);
                selectedRows.forEach(r => {
                    if (r.getData().result_id) {
                        addSampleToReport(r);
                    }
                });
                // Clear selection after adding
                window.reportCreator.leftTable.deselectRow();
            } else {
                // Clicked row not in selection, add just this sample
                console.log('[Creator] Double-click - Adding single sample to report:', data.result_id);
                addSampleToReport(row);
            }
        }
    });

    // Add double-click handler for group headers to bulk add all samples
    window.reportCreator.leftTable.on("groupDblClick", function(e, group) {
        const groupRows = group.getRows();
        const sampleCount = groupRows.length;

        if (sampleCount === 0) {
            console.log('[Creator] No samples in this group');
            return;
        }

        const activeGroupSelect = document.getElementById('active-group-select');
        const targetGroup = activeGroupSelect ? activeGroupSelect.value : 'Default';

        console.log(`[Creator] 🚀 Bulk adding ${sampleCount} samples from "${group.getKey()}" to group "${targetGroup}"`);

        // Add all samples from this group
        groupRows.forEach(row => {
            if (row.getData().result_id) {
                addSampleToReport(row);
            }
        });

        console.log(`[Creator] ✅ Bulk added ${sampleCount} samples to report`);
    });

    // Add Alt+Click handler for group headers to preview all samples in group
    window.reportCreator.leftTable.on("groupClick", function(e, group) {
        if (e.altKey) {
            e.stopPropagation(); // Prevent expand/collapse
            e.preventDefault(); // Prevent default behavior

            const groupRows = group.getRows();
            const resultIds = groupRows
                .map(row => row.getData().result_id)
                .filter(id => id && !String(id).startsWith('placeholder_'));

            if (resultIds.length > 0) {
                console.log(`[Creator] Alt+Click on group - Previewing ${resultIds.length} samples from "${group.getKey()}"`);
                if (previewModal) {
                    previewModal.showPreview(resultIds);
                }
            }
            return false; // Stop event propagation
        }
    });

    // Add handler to clear selection when clicking empty table space
    window.reportCreator.leftTable.on("tableClick", function(e) {
        // This event fires when clicking on the table container but not on rows or groups
        const selectedRows = window.reportCreator.leftTable.getSelectedRows();
        if (selectedRows.length > 0) {
            console.log('[Creator] Clicked empty space - Clearing selection');
            window.reportCreator.leftTable.deselectRow();
        }
    });

    console.log('[Creator] Left table initialized');
}

/**
 * Natural sort function for sample names
 * Handles formats like FB-123, FD-011-001, UPFB-45, etc.
 * Sorts by prefix, then by numeric parts in order
 */
function naturalSortSampleName(a, b, aRow, bRow, column, dir, sorterParams) {
    const aVal = a || '';
    const bVal = b || '';

    // Split sample names into parts (prefix and numbers)
    const parsePattern = /([A-Z]+)-?(\d+)?-?(\d+)?/i;
    const aMatch = aVal.match(parsePattern);
    const bMatch = bVal.match(parsePattern);

    if (!aMatch || !bMatch) {
        // Fall back to string comparison if pattern doesn't match
        return aVal.localeCompare(bVal);
    }

    // Compare prefix (FB, FD, UP, UPFB, etc.)
    const aPrefix = aMatch[1] || '';
    const bPrefix = bMatch[1] || '';
    const prefixCompare = aPrefix.localeCompare(bPrefix);

    if (prefixCompare !== 0) {
        return prefixCompare;
    }

    // Compare first number
    const aNum1 = aMatch[2] ? parseInt(aMatch[2], 10) : 0;
    const bNum1 = bMatch[2] ? parseInt(bMatch[2], 10) : 0;

    if (aNum1 !== bNum1) {
        return aNum1 - bNum1;
    }

    // Compare second number if exists
    const aNum2 = aMatch[3] ? parseInt(aMatch[3], 10) : 0;
    const bNum2 = bMatch[3] ? parseInt(bMatch[3], 10) : 0;

    return aNum2 - bNum2;
}

/**
 * Initialize right table (Selected Samples with Groups)
 */
function initRightTable() {
    console.log('[Creator] Initializing right table...');

    window.reportCreator.rightTable = new Tabulator("#selected-samples-table", {
        height: "100%",
        layout: "fitDataStretch",
        placeholder: "Click samples to add to report",
        movableRows: true, // Enable row reordering within table
        movableRowsSender: false, // Don't delete rows when moving
        movableRowsReceiver: "update", // Update existing rows when receiving
        groupBy: "group", // Group by the 'group' field
        groupValues: [window.reportCreator.groups.map(g => g.name)], // Define valid group values
        groupStartOpen: true, // All groups open by default
        initialSort: [
            {column: "sample_name", dir: "asc"} // Sort by sample name within groups
        ],
        groupHeader: function (value, count, data, group) {
            // Find group color
            const groupObj = window.reportCreator.groups.find(g => g.name === value);
            const color = groupObj ? groupObj.color : '#999';

            // Get real count (exclude placeholders)
            const rows = group.getRows();
            const realCount = rows.filter(row => !row.getData()._isPlaceholder).length;

            // For Standards group, add date if there are samples
            let displayText = value;
            if (value === 'Standards' && realCount > 0) {
                // Get the most recent date from standards samples
                const dates = rows
                    .filter(row => !row.getData()._isPlaceholder)
                    .map(row => row.getData().date_acquired)
                    .filter(Boolean);

                if (dates.length > 0) {
                    // Use the first date (they should all be from same run)
                    const dateObj = new Date(dates[0]);
                    const formattedDate = dateObj.toLocaleDateString();
                    displayText = `STD - ${formattedDate}`;
                }
            }

            // Format: "Group Name - X samples" with rename icon
            return `<span style="color: ${color}; font-weight: 600;">
                        <i class="bi bi-folder-fill me-2"></i>${displayText} - ${realCount} sample${realCount !== 1 ? 's' : ''}
                        <i class="bi bi-pencil-square ms-2 rename-group-icon"
                           style="cursor: pointer; font-size: 0.9em;"
                           data-group-name="${value}"
                           title="Rename group"></i>
                    </span>`;
        },
        rowFormatter: function(row) {
            const data = row.getData();
            if (data._isPlaceholder) {
                // Mark placeholder rows with a class for CSS hiding
                row.getElement().classList.add('placeholder-row');
            }
        },
        columns: [
            {
                rowHandle: true,
                formatter: "handle",
                headerSort: false,
                frozen: true,
                width: 40,
                minWidth: 40
            },
            {
                title: "",
                field: "actions",
                width: 50,
                headerSort: false,
                frozen: true,
                hozAlign: "center",
                formatter: function (cell) {
                    return '<button class="btn btn-sm btn-outline-danger remove-sample-btn"><i class="bi bi-trash"></i></button>';
                },
                cellClick: function (e, cell) {
                    e.stopPropagation();
                    removeSample(cell.getRow());
                }
            },
            {
                title: "Sample Name",
                field: "sample_name",
                sorter: naturalSortSampleName
            },
            {
                title: "Result ID",
                field: "result_id",
                width: 120,
                hozAlign: "center",
                sorter: "number"
            },
            {
                title: "System",
                field: "system_name",
                sorter: "string"
            },
            {
                title: "Sample Set",
                field: "sample_set_name",
                sorter: "string"
            },
            {
                title: "Date",
                field: "date_acquired",
                width: 120,
                sorter: "date",
                formatter: function (cell) {
                    const val = cell.getValue();
                    return val ? new Date(val).toLocaleDateString() : 'N/A';
                }
            },
            {
                title: "Group",
                field: "group",
                width: 150,
                editor: "list",
                editorParams: function () {
                    return {
                        values: window.reportCreator.groups.map(g => g.name)
                    };
                },
                cellEdited: function (cell) {
                    console.log('[Creator] Group changed for row:', cell.getRow().getData().result_id, 'to:', cell.getValue());
                    updateCounts();
                }
            }
        ],
        // When row is added, update counts and re-sort within group
        rowAdded: function (row) {
            const data = row.getData();
            console.log('[Creator] 📥 rowAdded callback - Sample:', data.result_id, 'Group:', data.group);
            console.log('[Creator] 🔍 DEBUG - rowAdded full data:', JSON.stringify(data));

            // Re-apply sort to keep samples ordered within their groups
            window.reportCreator.rightTable.setSort([
                {column: "sample_name", dir: "asc"}
            ]);

            updateCounts();
        },
        rowDeleted: function (row) {
            const rowData = row.getData();
            console.log('[Creator] Sample removed:', rowData.result_id);
            updateCounts();
        },
        // When row is moved between groups, preserve the group assignment
        rowMoved: function (row) {
            // Tabulator automatically handles group reassignment when dropping into a group
            // Just log and update counts
            const data = row.getData();
            console.log('[Creator] Sample moved:', data.result_id, 'to group:', data.group);
            updateCounts();
        }
    });

    // Add Alt+Click handler for individual rows in right table to preview
    window.reportCreator.rightTable.on("rowClick", function(e, row) {
        const data = row.getData();
        if (e.altKey && data && data.result_id && !data._isPlaceholder) {
            console.log('[Creator] Alt+Click on right table - Previewing sample:', data.result_id);
            if (previewModal) {
                previewModal.showPreview(data.result_id);
            }
        }
    });

    // Add Alt+Click handler for group headers in right table to preview all samples in group
    window.reportCreator.rightTable.on("groupClick", function(e, group) {
        // Check if clicking on rename icon
        if (e.target.classList.contains('rename-group-icon')) {
            e.stopPropagation();
            renameGroup(group.getKey());
            return;
        }

        // Don't trigger preview/expand if Alt key is held
        if (e.altKey) {
            e.stopPropagation();
            e.preventDefault();

            const groupRows = group.getRows();
            const resultIds = groupRows
                .map(row => row.getData().result_id)
                .filter(id => id && !String(id).startsWith('placeholder_'));

            if (resultIds.length > 0) {
                console.log(`[Creator] Alt+Click on right table group - Previewing ${resultIds.length} samples from "${group.getKey()}"`);
                if (previewModal) {
                    previewModal.showPreview(resultIds);
                }
            }
            return false;
        }
    });

    // Wait for table to be fully built before adding placeholders
    window.reportCreator.rightTable.on("tableBuilt", function() {
        console.log('[Creator] 🔍 DEBUG - tableBuilt event fired');
        initializeEmptyGroups();
    });

    console.log('[Creator] Right table initialized');
}

/**
 * Initialize empty group placeholders to make groups visible
 */
function initializeEmptyGroups() {
    console.log('[Creator] 🔍 DEBUG - initializeEmptyGroups called');
    console.log('[Creator] 🔍 DEBUG - Available groups:', JSON.stringify(window.reportCreator.groups));

    const placeholders = window.reportCreator.groups.map(group => ({
        result_id: `placeholder_${group.id}`,
        sample_name: '',
        system_name: '',
        sample_set_name: '',
        group: group.name,
        _isPlaceholder: true
    }));

    console.log('[Creator] 🔍 DEBUG - Created placeholders:', JSON.stringify(placeholders));

    window.reportCreator.rightTable.setData(placeholders);
    console.log('[Creator] ✅ Initialized empty groups:', window.reportCreator.groups.map(g => g.name).join(', '));

    // Verify data was set
    const tableData = window.reportCreator.rightTable.getData();
    console.log('[Creator] 🔍 DEBUG - Table data after setData:', JSON.stringify(tableData));
}

/**
 * Load samples from server into left table
 * Dynamically adjusts virtualDomBuffer based on sample count
 */
async function loadSamples(prefix = 'ALL', project = '') {
    // Get selected limit from dropdown
    const limitSelect = document.getElementById('sample-limit-select');
    const limit = limitSelect ? limitSelect.value : '500';

    console.log(`[Creator] Loading samples (limit: ${limit})...`);

    try {
        let url = `/analytical/sec/api/list-samples/?prefix=${prefix}&limit=${limit}`;
        if (project) url += `&project=${project}`;

        const res = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const data = await res.json();
        console.log('[Creator] Loaded', data.samples.length, 'samples');

        // Filter out samples that are already in the right table
        const rightTableData = window.reportCreator.rightTable.getData();
        const rightTableIds = new Set(rightTableData.map(s => s.result_id));

        const availableSamples = data.samples.filter(s => !rightTableIds.has(s.result_id));

        // Disable grouping for "All samples" to prevent scroll issues with large datasets
        const enableGrouping = limit !== 'all';

        // Calculate optimal buffer size based on sample count
        const optimalBuffer = calculateVirtualDomBuffer(availableSamples.length);
        console.log(`[Creator] Calculated virtualDomBuffer: ${optimalBuffer} for ${availableSamples.length} samples, grouping: ${enableGrouping}`);

        // Rebuild table if buffer size OR grouping state has changed
        const needsRebuild = (optimalBuffer !== window.reportCreator.currentVirtualDomBuffer) ||
                             (enableGrouping !== window.reportCreator.currentGroupingEnabled);

        if (needsRebuild) {
            console.log(`[Creator] Rebuilding table - buffer: ${window.reportCreator.currentVirtualDomBuffer} → ${optimalBuffer}, grouping: ${window.reportCreator.currentGroupingEnabled} → ${enableGrouping}`);
            window.reportCreator.currentVirtualDomBuffer = optimalBuffer;
            window.reportCreator.currentGroupingEnabled = enableGrouping;

            // Destroy existing table
            if (window.reportCreator.leftTable) {
                window.reportCreator.leftTable.destroy();
            }

            // Reinitialize with new buffer and grouping settings
            initLeftTable(optimalBuffer, enableGrouping);

            // Wait for table to be fully built before setting data
            await new Promise(resolve => {
                const tableBuiltHandler = function() {
                    window.reportCreator.leftTable.off("tableBuilt", tableBuiltHandler);
                    resolve();
                };
                window.reportCreator.leftTable.on("tableBuilt", tableBuiltHandler);
            });
        }

        window.reportCreator.leftTable.setData(availableSamples);

        // Update Group/Ungroup button state
        const groupBtn = document.getElementById('group-by-sample-set-btn');
        if (groupBtn) {
            if (!enableGrouping) {
                // Disable button for "All samples" mode
                groupBtn.disabled = true;
                groupBtn.innerHTML = '<i class="bi bi-grid-3x3-gap"></i> Grouping Disabled';
                groupBtn.classList.remove('btn-primary', 'btn-outline-primary');
                groupBtn.classList.add('btn-secondary');
                groupBtn.title = 'Grouping is disabled for "All samples" to prevent scroll issues';
            } else {
                // Re-enable button when not in "All samples" mode
                groupBtn.disabled = false;
                groupBtn.classList.remove('btn-secondary');
                if (window.reportCreator.leftTableGrouped) {
                    groupBtn.innerHTML = '<i class="bi bi-grid-3x3-gap"></i> Ungroup';
                    groupBtn.classList.add('btn-primary');
                } else {
                    groupBtn.innerHTML = '<i class="bi bi-grid-3x3-gap"></i> Group';
                    groupBtn.classList.add('btn-outline-primary');
                }
                groupBtn.title = 'Group samples by sample set';
            }
        }

        // Populate project filter dropdown (preserve selection)
        const projects = [...new Set(data.samples.map(s => s.sample_set_name).filter(Boolean))];
        const projectFilter = document.getElementById('project-filter');
        const currentValue = projectFilter.value; // Save current selection

        projectFilter.innerHTML = '<option value="">All Sample Sets</option>';
        projects.forEach(p => {
            const selected = p === currentValue ? 'selected' : '';
            projectFilter.innerHTML += `<option value="${p}" ${selected}>${p}</option>`;
        });

    } catch (err) {
        console.error('[Creator] Load error:', err);
        alert('Failed to load samples: ' + err.message);
    }
}

/**
 * Auto-group samples based on pattern matching
 * @param {string} sampleName - The sample name to check
 * @returns {string} - The group name ('Standards', 'Blanks', or 'Default')
 */
function autoGroupSample(sampleName) {
    console.log('[Creator] 🔍 DEBUG - autoGroupSample called with:', sampleName);

    if (!sampleName) {
        console.log('[Creator] 🔍 DEBUG - Empty sample name, returning Default');
        return 'Default';
    }

    const nameLower = sampleName.toLowerCase();
    console.log('[Creator] 🔍 DEBUG - Lowercase name:', nameLower);

    // Standards patterns (checked first - takes priority)
    const standardsPatterns = ['std', 'stds', 'standard'];
    const matchesStandard = standardsPatterns.some(pattern => {
        const matches = nameLower.includes(pattern);
        console.log(`[Creator] 🔍 DEBUG - Checking pattern "${pattern}":`, matches);
        return matches;
    });

    if (matchesStandard) {
        console.log('[Creator] 🎯 Auto-grouped as Standards:', sampleName);
        return 'Standards';
    }

    // Blanks patterns
    const blanksPatterns = ['blank', 'h2o', 'h20', 'gucl'];
    const matchesBlank = blanksPatterns.some(pattern => {
        const matches = nameLower.includes(pattern);
        console.log(`[Creator] 🔍 DEBUG - Checking pattern "${pattern}":`, matches);
        return matches;
    });

    if (matchesBlank) {
        console.log('[Creator] 🎯 Auto-grouped as Blanks:', sampleName);
        return 'Blanks';
    }

    // Default group if no match
    console.log('[Creator] 📋 Auto-grouped as Default:', sampleName);
    return 'Default';
}

/**
 * Add a sample from left table to right table
 */
function addSampleToReport(row) {
    const data = row.getData();
    console.log('[Creator] 🔍 DEBUG - addSampleToReport called with data:', JSON.stringify(data));

    // Check if already in right table
    const rightTableData = window.reportCreator.rightTable.getData();
    const alreadyExists = rightTableData.some(s => s.result_id === data.result_id);

    if (alreadyExists) {
        console.log('[Creator] Sample already in report:', data.result_id);
        return;
    }

    // Get selected group from dropdown
    const activeGroupSelect = document.getElementById('active-group-select');
    const selectedGroup = activeGroupSelect ? activeGroupSelect.value : 'Auto';
    console.log('[Creator] 🔍 DEBUG - Selected group from dropdown:', selectedGroup);

    let targetGroup;
    if (selectedGroup === 'Auto') {
        // Auto-group based on sample name pattern matching
        targetGroup = autoGroupSample(data.sample_name);
        console.log('[Creator] 🎯 Auto-grouping:', data.sample_name, '→', targetGroup);
    } else {
        // Use manually selected group
        targetGroup = selectedGroup;
        console.log('[Creator] 📌 Manual grouping:', data.sample_name, '→', targetGroup);
    }

    console.log('[Creator] 🔍 DEBUG - Final target group:', targetGroup);

    // Add to right table with assigned group
    const sampleData = {
        ...data,
        group: targetGroup
    };

    console.log('[Creator] 🔍 DEBUG - Sample data to add:', JSON.stringify(sampleData));

    // Remove placeholder for this group if it exists (first real sample in group)
    const placeholderInGroup = rightTableData.find(r => r._isPlaceholder && r.group === targetGroup);
    console.log('[Creator] 🔍 DEBUG - Placeholder in group:', placeholderInGroup);

    if (placeholderInGroup) {
        const placeholderRow = window.reportCreator.rightTable.getRow(placeholderInGroup.result_id);
        if (placeholderRow) {
            placeholderRow.delete();
            console.log('[Creator] 🗑️ Removed placeholder for group:', targetGroup);
        }
    }

    window.reportCreator.rightTable.addData([sampleData]);
    console.log('[Creator] 🔍 DEBUG - Sample added to table');

    // Verify it was added
    const updatedData = window.reportCreator.rightTable.getData();
    console.log('[Creator] 🔍 DEBUG - Table data after adding sample:', JSON.stringify(updatedData));

    // Remove from left table
    row.delete();

    console.log('[Creator] ✅ Added sample to report:', data.result_id, 'in group:', targetGroup);
}

/**
 * Toggle grouping on left table by sample set
 */
function toggleLeftTableGrouping() {
    window.reportCreator.leftTableGrouped = !window.reportCreator.leftTableGrouped;

    const btn = document.getElementById('group-by-sample-set-btn');

    if (window.reportCreator.leftTableGrouped) {
        // Enable grouping
        window.reportCreator.leftTable.setGroupBy("sample_set_name");

        btn.innerHTML = '<i class="bi bi-grid-3x3-gap"></i> Ungroup';
        btn.classList.remove('btn-outline-primary');
        btn.classList.add('btn-primary');
        console.log('[Creator] ✅ Left table grouped by sample set (all collapsed)');
    } else {
        // Disable grouping
        window.reportCreator.leftTable.setGroupBy(false);
        btn.innerHTML = '<i class="bi bi-grid-3x3-gap"></i> Group by Sample Set';
        btn.classList.remove('btn-primary');
        btn.classList.add('btn-outline-primary');
        console.log('[Creator] ❌ Left table ungrouped');
    }
}

/**
 * Remove a sample from the right table
 */
function removeSample(row) {
    const data = row.getData();
    console.log('[Creator] Removing sample:', data.result_id);

    const removedGroup = data.group;

    // Delete from right table
    row.delete();

    // Check if this was the last real sample in the group
    const rightTableData = window.reportCreator.rightTable.getData();
    const realSamplesInGroup = rightTableData.filter(r => !r._isPlaceholder && r.group === removedGroup);

    // If group is now empty and it's a default group, add placeholder back
    if (realSamplesInGroup.length === 0) {
        const isDefaultGroup = window.reportCreator.groups.slice(0, 3).some(g => g.name === removedGroup);
        if (isDefaultGroup) {
            const groupObj = window.reportCreator.groups.find(g => g.name === removedGroup);
            if (groupObj) {
                const placeholder = {
                    result_id: `placeholder_${groupObj.id}`,
                    sample_name: '',
                    system_name: '',
                    sample_set_name: '',
                    group: groupObj.name,
                    _isPlaceholder: true
                };
                window.reportCreator.rightTable.addData([placeholder]);
                console.log('[Creator] ➕ Re-added placeholder for empty group:', removedGroup);
            }
        }
    }

    // Add back to left table
    window.reportCreator.leftTable.addData([data]);
}

/**
 * Update groupValues in right table to match current groups
 */
function updateGroupValues() {
    const groupNames = window.reportCreator.groups.map(g => g.name);
    window.reportCreator.rightTable.setGroupValues([groupNames]);
    console.log('[Creator] 🔄 Updated groupValues:', groupNames);
}

/**
 * Create a new group
 */
function createGroup() {
    const name = prompt('Enter group name:');
    if (!name || !name.trim()) return;

    const trimmed = name.trim();

    // Check for duplicate names (including protected groups)
    if (window.reportCreator.groups.some(g => g.name === trimmed)) {
        alert('Group already exists');
        return;
    }

    const colorIndex = window.reportCreator.groups.length % window.reportCreator.colorPalette.length;
    const newGroup = {
        id: window.reportCreator.nextGroupId++,
        name: trimmed,
        color: window.reportCreator.colorPalette[colorIndex]
    };

    window.reportCreator.groups.push(newGroup);

    console.log('[Creator] ✅ Created group:', trimmed);
    console.log('[Creator] 🔍 DEBUG - New group object:', JSON.stringify(newGroup));
    console.log('[Creator] 🔍 DEBUG - All groups:', JSON.stringify(window.reportCreator.groups));

    // Update the Group column's editor options
    const groupColumn = window.reportCreator.rightTable.getColumn("group");
    if (groupColumn) {
        groupColumn.updateDefinition({
            editorParams: {
                values: window.reportCreator.groups.map(g => g.name)
            }
        });
    }

    // Add to active group dropdown and select it
    const activeGroupSelect = document.getElementById('active-group-select');
    if (activeGroupSelect) {
        const option = document.createElement('option');
        option.value = trimmed;
        option.textContent = trimmed;
        option.selected = true; // Auto-select the new group
        activeGroupSelect.appendChild(option);
    }

    // Update groupValues to include the new group
    updateGroupValues();

    console.log('[Creator] ✅ New group created and added to dropdown');
}

/**
 * Rename an existing group
 */
function renameGroup(oldGroupName) {
    // Protect Standards and Blanks groups from being renamed
    if (oldGroupName === 'Standards' || oldGroupName === 'Blanks') {
        alert(`The "${oldGroupName}" group cannot be renamed. It is a protected default group.`);
        return;
    }

    const newGroupName = prompt(`Rename group "${oldGroupName}":`, oldGroupName);

    if (!newGroupName || !newGroupName.trim()) {
        return; // User cancelled or entered empty name
    }

    const trimmed = newGroupName.trim();

    // Check if name already exists (and it's not the same group)
    if (trimmed !== oldGroupName && window.reportCreator.groups.some(g => g.name === trimmed)) {
        alert('A group with that name already exists');
        return;
    }

    // If same name, no need to do anything
    if (trimmed === oldGroupName) {
        return;
    }

    console.log('[Creator] Renaming group:', oldGroupName, '->', trimmed);

    // Update group in groups array
    const groupObj = window.reportCreator.groups.find(g => g.name === oldGroupName);
    if (groupObj) {
        groupObj.name = trimmed;
    }

    // Update all samples with this group
    const rows = window.reportCreator.rightTable.getRows();
    rows.forEach(row => {
        const rowData = row.getData();
        if (rowData.group === oldGroupName) {
            row.update({group: trimmed});
        }
    });

    // Update the Group column's editor options
    const groupColumn = window.reportCreator.rightTable.getColumn("group");
    if (groupColumn) {
        groupColumn.updateDefinition({
            editorParams: {
                values: window.reportCreator.groups.map(g => g.name)
            }
        });
    }

    // Update active group dropdown
    const activeGroupSelect = document.getElementById('active-group-select');
    if (activeGroupSelect) {
        const currentSelection = activeGroupSelect.value;
        const options = activeGroupSelect.querySelectorAll('option');
        options.forEach(option => {
            if (option.value === oldGroupName) {
                option.value = trimmed;
                option.textContent = trimmed;
            }
        });
        // If the renamed group was selected, keep it selected
        if (currentSelection === oldGroupName) {
            activeGroupSelect.value = trimmed;
        }
    }

    // Update groupValues to reflect renamed group
    updateGroupValues();

    console.log('[Creator] ✅ Group renamed successfully');
}

/**
 * Update sample counts display
 */
function updateCounts() {
    const allData = window.reportCreator.rightTable.getData();
    const count = allData.length;
    const elem = document.getElementById('total-samples-count');
    if (elem) {
        elem.textContent = `${count} sample${count !== 1 ? 's' : ''}`;
        console.log('[Creator] 📊 Updated count display:', count, 'samples');
    } else {
        console.warn('[Creator] ⚠️ Count element not found!');
    }
}

/**
 * Create or update report
 */
async function createReport(e) {
    e.preventDefault();

    const reportName = document.getElementById('report-name').value.trim();
    const projectId = document.getElementById('project-id').value.trim();
    const userInitials = document.getElementById('user-id').value.trim();

    if (!reportName || !projectId || !userInitials) {
        alert('Please fill in all required fields');
        return;
    }

    const rightTableData = window.reportCreator.rightTable.getData();

    // Filter out placeholder rows
    const realSamples = rightTableData.filter(row => !row._isPlaceholder);

    if (realSamples.length === 0) {
        alert('Please add at least one sample to the report');
        return;
    }

    const sampleData = realSamples.map(row => ({
        result_id: row.result_id,
        sample_name: row.sample_name,
        group: row.group || 'Default'
    }));

    // Check if we're editing an existing report
    const urlParams = new URLSearchParams(window.location.search);
    const reportId = urlParams.get('report_id');
    const isEdit = !!reportId;

    console.log(`[Creator] ${isEdit ? 'Updating' : 'Creating'} report with`, sampleData.length, 'samples');

    const btn = document.querySelector('#report-form button[type="submit"]');
    const origText = btn.innerHTML;
    btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span>${isEdit ? 'Updating' : 'Creating'}...`;
    btn.disabled = true;

    try {
        const url = isEdit ? `/analytical/sec/api/update-report/${reportId}/` : '/analytical/sec/api/create-report/';
        const res = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': getCookie('csrftoken')
            },
            body: JSON.stringify({
                report_name: reportName,
                project_id: projectId,
                user_initials: userInitials,
                sample_data: sampleData
            })
        });

        if (!res.ok) {
            const err = await res.json();
            throw new Error(err.error || `Failed to ${isEdit ? 'update' : 'create'} report`);
        }

        const result = await res.json();
        const finalReportId = result.report_id || reportId;
        console.log(`[Creator] Report ${isEdit ? 'updated' : 'created'}:`, finalReportId);

        alert(`Report ${isEdit ? 'updated' : 'created'} successfully! Report ID: ${finalReportId}`);

        if (confirm('Open report in SEC app?')) {
            window.location.href = `/analytical/sec/?report_id=${finalReportId}`;
        } else {
            window.location.reload();
        }
    } catch (err) {
        console.error('[Creator] Error:', err);
        alert(`Failed to ${isEdit ? 'update' : 'create'} report: ` + err.message);
    } finally {
        btn.innerHTML = origText;
        btn.disabled = false;
    }
}

/**
 * Get CSRF token from cookies
 */
function getCookie(name) {
    let val = null;
    if (document.cookie) {
        const cookies = document.cookie.split(';');
        for (let cookie of cookies) {
            cookie = cookie.trim();
            if (cookie.startsWith(name + '=')) {
                val = decodeURIComponent(cookie.substring(name.length + 1));
                break;
            }
        }
    }
    return val;
}

/**
 * Load existing report for editing
 */
async function loadExistingReport(reportId) {
    console.log('[Creator] Loading existing report:', reportId);

    try {
        const res = await fetch(`/analytical/sec/api/get-report/${reportId}/`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const data = await res.json();
        console.log('[Creator] Report loaded:', data);

        // Pre-fill form fields
        document.getElementById('report-name').value = data.report_name || '';
        document.getElementById('project-id').value = data.project_id || '';
        document.getElementById('user-id').value = data.user_initials || '';

        // Load samples into right table
        if (data.samples && data.samples.length > 0) {
            // First, load all available samples
            await loadSamples();

            // Create groups that don't exist yet
            const uniqueGroups = [...new Set(data.samples.map(s => s.group).filter(Boolean))];
            uniqueGroups.forEach(groupName => {
                if (!window.reportCreator.groups.some(g => g.name === groupName)) {
                    const colorIndex = window.reportCreator.groups.length % window.reportCreator.colorPalette.length;
                    window.reportCreator.groups.push({
                        id: window.reportCreator.nextGroupId++,
                        name: groupName,
                        color: window.reportCreator.colorPalette[colorIndex]
                    });
                }
            });

            // Get full sample data from left table for each sample in the report
            const leftTableData = window.reportCreator.leftTable.getData();
            const samplesToAdd = [];

            data.samples.forEach(reportSample => {
                const fullSample = leftTableData.find(s => s.result_id === reportSample.result_id);
                if (fullSample) {
                    samplesToAdd.push({
                        ...fullSample,
                        group: reportSample.group || 'Default'
                    });
                }
            });

            // Add samples to right table
            window.reportCreator.rightTable.setData(samplesToAdd);

            // Remove those samples from left table
            const sampleIds = samplesToAdd.map(s => s.result_id);
            window.reportCreator.leftTable.getData().forEach((row, index) => {
                if (sampleIds.includes(row.result_id)) {
                    const tabulatorRow = window.reportCreator.leftTable.getRows()[index];
                    if (tabulatorRow) {
                        tabulatorRow.delete();
                    }
                }
            });

            updateCounts();
            console.log('[Creator] ✓ Report loaded with', data.samples.length, 'samples');
        }

        // Change page title
        document.title = `Edit: ${data.report_name}`;

    } catch (err) {
        console.error('[Creator] Error loading report:', err);
        alert('Failed to load report: ' + err.message);
    }
}

/**
 * SEC Chromatogram Preview Modal
 */
class SecPreviewModal {
    constructor() {
        this.modal = null;
        this.plotDiv = document.getElementById('preview-plot');
        this.loadingDiv = document.getElementById('preview-loading');
        this.sampleCountBadge = document.getElementById('preview-sample-count');
        this.toggleModeBtn = document.getElementById('preview-toggle-mode');
        this.downloadBtn = document.getElementById('preview-download');
        this.currentMode = 'overlay'; // 'overlay' or 'subplots'
        this.currentData = null;
        this.currentSamples = [];

        this.initModal();
    }

    initModal() {
        this.modal = new bootstrap.Modal(document.getElementById('previewModal'));

        // Toggle mode button
        this.toggleModeBtn.addEventListener('click', () => this.togglePlotMode());

        // Download button
        this.downloadBtn.addEventListener('click', () => this.downloadPlot());
    }

    /**
     * Show preview for a single sample or group of samples
     */
    async showPreview(resultIds, title = 'SEC Chromatogram') {
        if (!Array.isArray(resultIds)) {
            resultIds = [resultIds];
        }

        this.currentSamples = resultIds;
        this.sampleCountBadge.textContent = `${resultIds.length} sample${resultIds.length !== 1 ? 's' : ''}`;

        // Show modal and loading state
        this.modal.show();
        this.loadingDiv.classList.remove('d-none');
        this.plotDiv.innerHTML = '';

        try {
            // Fetch chromatogram data for all samples
            const response = await fetch('/analytical/sec/api/get-chromatograms/', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRFToken': this.getCsrfToken()
                },
                body: JSON.stringify({ result_ids: resultIds })
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const data = await response.json();

            // Filter out any invalid traces
            if (data.traces && Array.isArray(data.traces)) {
                const originalCount = data.traces.length;
                const validTraces = [];
                data.traces.forEach((trace, idx) => {
                    try {
                        // Validate trace has required data
                        if (trace && trace.x && trace.y && Array.isArray(trace.x) && Array.isArray(trace.y)) {
                            validTraces.push(trace);
                        } else {
                            console.warn(`[Preview] ⚠️ Skipping invalid trace at index ${idx}:`, trace?.name || 'unknown');
                        }
                    } catch (error) {
                        console.warn(`[Preview] ⚠️ Error validating trace "${trace?.name || 'unknown'}":`, error.message);
                    }
                });

                data.traces = validTraces;
                if (originalCount !== validTraces.length) {
                    console.log(`[Preview] ⚠️ Loaded ${validTraces.length} valid traces out of ${originalCount} total (${originalCount - validTraces.length} skipped)`);
                } else {
                    console.log(`[Preview] ✓ Loaded ${validTraces.length} valid traces`);
                }
            }

            this.currentData = data;

            // Render plot
            this.renderPlot();

        } catch (error) {
            console.error('[Preview] Error loading chromatogram:', error);
            this.plotDiv.innerHTML = '<div class="alert alert-danger">Failed to load chromatogram. Please try again.</div>';
        } finally {
            this.loadingDiv.classList.add('d-none');
        }
    }

    /**
     * Render plot in current mode (overlay or subplots)
     */
    renderPlot() {
        if (!this.currentData || !this.currentData.traces) {
            return;
        }

        try {
            const traces = this.currentData.traces;

            if (this.currentMode === 'overlay') {
            // Overlay mode: all traces on single plot
            const layout = {
                title: 'SEC Chromatogram (Overlay)',
                xaxis: { title: 'Retention Time (min)' },
                yaxis: { title: 'UV280 (mAU)' },
                hovermode: 'closest',
                showlegend: true
            };

            Plotly.newPlot(this.plotDiv, traces, layout, {
                responsive: true,
                displayModeBar: true,
                modeBarButtonsToRemove: ['lasso2d', 'select2d'],
                toImageButtonOptions: {
                    format: 'png',
                    filename: 'sec_chromatogram',
                    height: 600,
                    width: 1000
                }
            });
        } else {
            // Subplot mode: separate plot for each trace
            const numSamples = traces.length;
            const cols = numSamples === 1 ? 1 : 2;
            const rows = Math.ceil(numSamples / cols);

            // Calculate dynamic height: 350px per row
            const plotHeight = rows * 350;
            this.plotDiv.style.height = `${plotHeight}px`;

            const layout = {
                title: {
                    text: 'SEC Chromatogram (Subplots)',
                    font: { size: 16 }
                },
                showlegend: false,
                height: plotHeight,
                grid: {
                    rows: rows,
                    columns: cols,
                    pattern: 'independent',
                    roworder: 'top to bottom'
                }
            };

            // Configure each subplot with proper axes and annotations
            traces.forEach((trace, idx) => {
                const row = Math.floor(idx / cols) + 1;
                const col = (idx % cols) + 1;

                // Calculate subplot number (Plotly uses row-major ordering)
                const subplotNum = idx + 1;
                const axisNum = subplotNum === 1 ? '' : subplotNum;

                // Calculate y-axis domain for this row
                const rowHeight = 1 / rows;
                const yStart = 1 - (row * rowHeight);
                const yEnd = yStart + rowHeight - 0.05; // Small gap between rows
                const yDomain = [yStart + 0.05, yEnd]; // Add padding

                // Add subplot title as annotation
                if (!layout.annotations) layout.annotations = [];
                layout.annotations.push({
                    text: `<b>${trace.name}</b>`,
                    font: { size: 12 },
                    showarrow: false,
                    xref: `x${axisNum} domain`,
                    yref: `y${axisNum} domain`,
                    x: 0.5,
                    y: 1.1,
                    xanchor: 'center',
                    yanchor: 'bottom'
                });

                // Configure axes for this subplot
                layout[`xaxis${axisNum}`] = {
                    title: {
                        text: 'Retention Time (min)',
                        font: { size: 10 }
                    },
                    domain: col === 1 ? [0, 0.48] : [0.52, 1],
                    showgrid: true,
                    zeroline: false
                };

                layout[`yaxis${axisNum}`] = {
                    title: {
                        text: 'UV280 (mAU)',
                        font: { size: 10 }
                    },
                    domain: yDomain,
                    showgrid: true,
                    zeroline: false
                };

                // Assign trace to correct subplot
                trace.xaxis = `x${axisNum}`;
                trace.yaxis = `y${axisNum}`;
            });

            Plotly.newPlot(this.plotDiv, traces, layout, {
                responsive: true,
                displayModeBar: true,
                modeBarButtonsToRemove: ['lasso2d', 'select2d'],
                toImageButtonOptions: {
                    format: 'png',
                    filename: 'sec_chromatogram_subplots',
                    height: plotHeight,
                    width: 1200
                }
            });
            }
        } catch (error) {
            console.error('[Preview] Error rendering plot:', error);
            this.plotDiv.innerHTML = `
                <div class="alert alert-warning m-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Error rendering plot:</strong> ${error.message}
                    <br><small>Some chromatogram data may be unavailable.</small>
                </div>
            `;
        }
    }

    /**
     * Toggle between overlay and subplot modes
     */
    togglePlotMode() {
        this.currentMode = this.currentMode === 'overlay' ? 'subplots' : 'overlay';
        this.renderPlot();
    }

    /**
     * Download plot as PNG
     */
    downloadPlot() {
        const filename = this.currentMode === 'overlay'
            ? 'sec_chromatogram.png'
            : 'sec_chromatogram_subplots.png';

        Plotly.downloadImage(this.plotDiv, {
            format: 'png',
            width: 1000,
            height: 600,
            filename: filename
        });
    }

    /**
     * Get CSRF token for POST requests
     */
    getCsrfToken() {
        return document.querySelector('[name=csrfmiddlewaretoken]')?.value || '';
    }
}

// Initialize preview modal
let previewModal = null;

/**
 * Initialize the application
 */
document.addEventListener('DOMContentLoaded', function () {
    console.log('[Creator] Initializing dual-table drag & drop workflow...');

    // Wait for Tabulator to load
    if (typeof Tabulator === 'undefined') {
        console.warn('[Creator] Tabulator not loaded yet, waiting...');
        setTimeout(function () {
            document.dispatchEvent(new Event('DOMContentLoaded'));
        }, 100);
        return;
    }

    // Initialize both tables
    initLeftTable();
    initRightTable();

    // Initialize the count display
    updateCounts();

    // Check if we're editing an existing report
    const urlParams = new URLSearchParams(window.location.search);
    const reportId = urlParams.get('report_id');

    if (reportId) {
        console.log('[Creator] Edit mode - loading report:', reportId);
        loadExistingReport(reportId);
    } else {
        console.log('[Creator] Create mode - starting fresh');
        loadSamples();
    }

    // Initialize preview modal
    previewModal = new SecPreviewModal();

    // Event listeners

    // Filter by prefix
    document.getElementById('prefix-filter').addEventListener('change', function () {
        loadSamples(this.value, document.getElementById('project-filter').value);
    });

    // Filter by project
    document.getElementById('project-filter').addEventListener('change', function () {
        loadSamples(document.getElementById('prefix-filter').value, this.value);
    });

    // Search filter
    document.getElementById('sample-search').addEventListener('input', function (e) {
        window.reportCreator.leftTable.setFilter('sample_name', 'like', e.target.value);
    });

    // Sample limit dropdown
    document.getElementById('sample-limit-select').addEventListener('change', function () {
        loadSamples(
            document.getElementById('prefix-filter').value,
            document.getElementById('project-filter').value
        );
    });

    // Group by Sample Set button
    document.getElementById('group-by-sample-set-btn').addEventListener('click', toggleLeftTableGrouping);

    // Add Group button
    document.getElementById('add-group-btn').addEventListener('click', createGroup);

    // Submit form
    document.getElementById('report-form').addEventListener('submit', createReport);

    console.log('[Creator] ✓ Ready! Click samples to add to report, organize into groups. Alt+Click to preview chromatograms.');
});
