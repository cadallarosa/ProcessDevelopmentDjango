{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create SEC Report</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #0056b3;
            --success: #28a745;
            --danger: #dc3545;
            --radius: 8px;
        }

        /* Single-page viewport layout */
        html, body {
            height: 100vh;
            overflow: hidden;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background: #f5f7fa;
        }

        .container-fluid {
            height: 100vh;
            max-width: 1900px;
            padding: 15px 20px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .page-header {
            flex: 0 0 auto;
            margin-bottom: 15px;
        }

        .page-header h2 {
            margin: 0;
            font-size: 1.5rem;
        }

        .page-header p {
            margin: 0;
            font-size: 0.875rem;
        }

        .main-layout {
            flex: 1;
            display: flex;
            gap: 20px;
            overflow: hidden;
            min-height: 0;
        }

        .left-panel, .right-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-height: 0;
        }

        .right-panel {
            gap: 15px;
        }

        .card {
            border: none;
            border-radius: var(--radius);
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-height: 0;
        }

        .card-header {
            background: var(--primary);
            color: white;
            font-weight: 600;
            padding: 10px 15px;
            border-radius: var(--radius) var(--radius) 0 0 !important;
            flex: 0 0 auto;
        }

        .card-body {
            flex: 1;
            padding: 15px;
            overflow-y: auto;
            min-height: 0;
        }

        /* Left panel card - fixed height, no scroll on card-body */
        .left-panel .card {
            flex: 1;
            max-height: 100%;
        }

        .left-panel .card-body {
            overflow: hidden;
            padding-bottom: 40px; /* Increased breathing room at bottom */
        }

        /* Right panel: Report Details is fixed size, Selected Samples fills remaining space */
        .right-panel .card:last-child {
            flex: 1;
            min-height: 0;
        }

        .right-panel .card-body {
            padding-bottom: 40px; /* Increased breathing room at bottom */
        }

        /* Table styling - compact and smaller text */
        #samples-table, #selected-samples-table {
            height: calc(100% - 20px); /* Add extra margin at bottom */
            font-size: 0.85rem;
        }

        /* Freeze headers for both tables */
        .tabulator-header {
            position: sticky !important;
            top: 0 !important;
            z-index: 10 !important;
            background-color: white !important;
        }

        /* Compact row heights */
        .tabulator-row {
            min-height: 28px !important;
        }

        .tabulator-cell {
            padding: 4px 8px !important;
        }

        /* Compact headers */
        .tabulator-col {
            padding: 6px 8px !important;
        }

        .tabulator-col-title {
            font-size: 0.8rem;
            font-weight: 600;
        }

        /* Compact header filters */
        .tabulator-header-filter input {
            font-size: 0.75rem;
            padding: 2px 6px;
            height: 24px;
        }

        /* Hover effects - click to add */
        #samples-table .tabulator-row:hover {
            background-color: #e8f5e9;
            cursor: pointer;
            border-left: 3px solid var(--success);
        }

        /* Right table hover - drag handles */
        #selected-samples-table .tabulator-row:hover {
            background-color: #f5f5f5;
        }

        /* Dragging state for right table */
        #selected-samples-table .tabulator-row.tabulator-moving {
            cursor: grabbing !important;
            opacity: 0.6;
            border: 2px dashed var(--primary) !important;
        }

        /* Group styling for both tables - compact */
        .tabulator-group {
            font-size: 0.85rem;
            padding: 4px 10px !important;
            min-height: 26px !important;
        }

        .tabulator-group-toggle {
            color: var(--primary);
        }

        /* Left table groups - plain text style */
        #samples-table .tabulator-group {
            background-color: #ffffff !important;
            border-bottom: 1px solid #dee2e6;
            border-top: 1px solid #dee2e6;
            font-weight: normal;
            color: #333;
            cursor: pointer;
        }

        #samples-table .tabulator-group:hover {
            background-color: #f8f9fa !important;
        }

        /* Right table groups - more prominent */
        #selected-samples-table .tabulator-group {
            background-color: #e3f2fd !important;
            font-weight: 600;
            color: var(--primary);
        }

        /* Fix group header alignment - force full table width */
        #selected-samples-table .tabulator-row.tabulator-group {
            display: table !important;
            table-layout: fixed !important;
            width: 100% !important;
        }

        #selected-samples-table .tabulator-group {
            display: table-cell !important;
            width: 100% !important;
        }

        /* Hide placeholder rows without affecting layout */
        #selected-samples-table .placeholder-row {
            display: none !important;
            height: 0 !important;
            min-height: 0 !important;
        }

        /* Drag handle styling */
        .tabulator-row-handle {
            cursor: grab;
            color: #999;
            user-select: none;
        }

        .tabulator-row-handle:hover {
            color: #333;
            cursor: grab;
        }

        .tabulator-row-handle:active {
            cursor: grabbing;
        }

        /* Multi-row selection styling for left table */
        #samples-table .tabulator-selected {
            background-color: #d1e7fd !important;
            border-left: 3px solid #0056b3 !important;
        }

        #samples-table .tabulator-selected:hover {
            background-color: #b8d4f5 !important;
        }

        /* Form elements */
        .stats-badge {
            background: #e7f1ff;
            color: var(--primary);
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        /* Remove bottom margins from cards */
        .card:last-child {
            margin-bottom: 0;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header d-flex justify-content-between align-items-center">
            <div>
                <h2><i class="bi bi-plus-circle"></i> Create SEC Report</h2>
                <p class="text-muted">Click samples to add to report, then organize into groups</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#helpModal">
                    <i class="bi bi-question-circle"></i> Help
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="window.history.back()">
                    <i class="bi bi-x-circle"></i> Cancel
                </button>
            </div>
        </div>

        <!-- Main Layout: Two Tables Side-by-Side -->
        <div class="main-layout">
            <!-- LEFT PANEL: Available Samples -->
            <div class="left-panel">
                <div class="card">
                    <div class="card-header"><i class="bi bi-table"></i> Available SEC Samples</div>
                    <div class="card-body">
                        <!-- Filters -->
                        <div class="row g-2 mb-2">
                            <div class="col-md-3">
                                <input type="text" class="form-control form-control-sm" id="sample-search" placeholder="Search samples...">
                            </div>
                            <div class="col-md-2">
                                <select class="form-select form-select-sm" id="prefix-filter">
                                    <option value="ALL">All Prefixes</option>
                                    <option value="FB">FB (CLD)</option>
                                    <option value="FD">FD (Formulation)</option>
                                    <option value="UP">UP (Upstream)</option>
                                    <option value="UPFB">UPFB (Upstream)</option>
                                    <option value="PD">PD (Downstream)</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select form-select-sm" id="project-filter">
                                    <option value="">All Sample Sets</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <select class="form-select form-select-sm" id="sample-limit-select">
                                    <option value="500">500 samples</option>
                                    <option value="1000" selected>1000 samples</option>
                                    <option value="1500">1500 samples</option>
                                    <option value="all">All samples</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-primary btn-sm w-100" id="group-by-sample-set-btn" title="Group samples by sample set">
                                    <i class="bi bi-grid-3x3-gap"></i> Ungroup
                                </button>
                            </div>
                        </div>
                        <!-- Table -->
                        <div id="samples-table"></div>
                    </div>
                </div>
            </div>

            <!-- RIGHT PANEL: Report Details + Selected Samples -->
            <div class="right-panel">
                <!-- Report Details Card -->
                <div class="card" style="flex: 0 0 auto;">
                    <div class="card-header"><i class="bi bi-file-earmark-text"></i> Report Details</div>
                    <div class="card-body">
                        <form id="report-form">
                            {% csrf_token %}
                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <label class="form-label small">Report Name *</label>
                                    <input type="text" class="form-control form-control-sm" id="report-name" required placeholder="e.g., FD-011 SEC Analysis">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small">Project ID *</label>
                                    <input type="text" class="form-control form-control-sm" id="project-id" required placeholder="e.g., SI-54X1">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small">Your Initials *</label>
                                    <input type="text" class="form-control form-control-sm" id="user-id" required placeholder="e.g., CAD" maxlength="10">
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <div class="form-text">
                                        <i class="bi bi-info-circle"></i>
                                        <span class="stats-badge" id="total-samples-count">0 samples</span> selected
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bi bi-save"></i> Create Report
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Selected Samples Card -->
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-list-check"></i> Selected Samples</span>
                        <div class="d-flex gap-2 align-items-center">
                            <label class="mb-0 small text-white">Add to:</label>
                            <select class="form-select form-select-sm" id="active-group-select" style="width: auto; min-width: 120px;">
                                <option value="Auto">Auto (Pattern Match)</option>
                                <option value="Default">Default</option>
                                <option value="Standards">Standards</option>
                                <option value="Blanks">Blanks</option>
                            </select>
                            <button class="btn btn-success btn-sm" id="add-group-btn" title="Add New Group">
                                <i class="bi bi-plus-circle"></i> Add Group
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="selected-samples-table"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Help Modal -->
    <div class="modal fade" id="helpModal" tabindex="-1" aria-labelledby="helpModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title" id="helpModalLabel">
                        <i class="bi bi-question-circle"></i> SEC Report Creator - Help & Shortcuts
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h6 class="fw-bold mb-3"><i class="bi bi-keyboard"></i> Keyboard Shortcuts</h6>

                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 30%;">Action</th>
                                    <th style="width: 25%;">Shortcut</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Add Sample</strong></td>
                                    <td><kbd>Click</kbd> on row</td>
                                    <td>Add individual sample to selected group</td>
                                </tr>
                                <tr>
                                    <td><strong>Bulk Add</strong></td>
                                    <td><kbd>Double-Click</kbd> on group header</td>
                                    <td>Add all samples from a sample set to selected group</td>
                                </tr>
                                <tr>
                                    <td><strong>Preview Sample</strong></td>
                                    <td><kbd>Alt</kbd> + <kbd>Click</kbd> on row</td>
                                    <td>Preview UV280 chromatogram for single sample</td>
                                </tr>
                                <tr>
                                    <td><strong>Preview Group</strong></td>
                                    <td><kbd>Alt</kbd> + <kbd>Click</kbd> on group header</td>
                                    <td>Preview all chromatograms in a sample set (overlay or subplots)</td>
                                </tr>
                                <tr>
                                    <td><strong>Remove Sample</strong></td>
                                    <td><kbd>Click</kbd> trash icon</td>
                                    <td>Remove sample from report (returns to available samples)</td>
                                </tr>
                                <tr>
                                    <td><strong>Rename Group</strong></td>
                                    <td><kbd>Click</kbd> on group header (right table)</td>
                                    <td>Rename a custom group (Default group cannot be renamed)</td>
                                </tr>
                                <tr>
                                    <td><strong>Expand/Collapse</strong></td>
                                    <td><kbd>Click</kbd> on group header (left table)</td>
                                    <td>Toggle group visibility in available samples</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <hr>

                    <h6 class="fw-bold mb-3"><i class="bi bi-lightbulb"></i> Workflow Tips</h6>

                    <ul>
                        <li><strong>Group Samples:</strong> Use the "Group" button to organize available samples by sample set</li>
                        <li><strong>Create Custom Groups:</strong> Click "+ Add Group" to create new groups for organizing your report</li>
                        <li><strong>Switch Active Group:</strong> Use the "Add to:" dropdown to choose which group new samples are added to</li>
                        <li><strong>Drag to Reorder:</strong> In the right table, use the drag handle (☰) to reorder samples within or between groups</li>
                        <li><strong>Filter Samples:</strong> Use the search box and filters at the top to quickly find specific samples</li>
                        <li><strong>Preview Before Adding:</strong> Use Alt+Click to preview chromatograms before adding samples to your report</li>
                    </ul>

                    <hr>

                    <h6 class="fw-bold mb-3"><i class="bi bi-info-circle"></i> Additional Features</h6>

                    <ul>
                        <li><strong>Overlay vs Subplots:</strong> In the preview modal, toggle between viewing all chromatograms overlaid or as separate subplots</li>
                        <li><strong>Download Plots:</strong> Export preview plots as PNG images from the preview modal</li>
                        <li><strong>Interactive Zoom:</strong> Use mouse wheel to zoom and click-drag to pan in chromatogram previews</li>
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-info" data-bs-dismiss="modal">Got it!</button>
                </div>
            </div>
        </div>
    </div>

    <!-- SEC Chromatogram Preview Modal -->
    <div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="previewModalLabel">
                        <i class="bi bi-graph-up"></i> SEC Chromatogram Preview
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="max-height: 80vh; overflow-y: auto;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex gap-2">
                            <button id="preview-toggle-mode" class="btn btn-sm btn-outline-primary" title="Toggle between overlay and subplot view">
                                <i class="bi bi-grid-3x3"></i> Toggle Overlay/Subplots
                            </button>
                            <button id="preview-download" class="btn btn-sm btn-outline-secondary" title="Download plot as PNG">
                                <i class="bi bi-download"></i> Download PNG
                            </button>
                        </div>
                        <div id="preview-loading" class="d-none">
                            <span class="spinner-border spinner-border-sm text-primary me-2"></span>
                            <span class="text-muted">Loading chromatogram...</span>
                        </div>
                        <div id="preview-sample-count" class="badge bg-info"></div>
                    </div>
                    <div id="preview-plot" style="width: 100%; min-height: 500px; border: 1px solid #dee2e6; border-radius: 4px;"></div>
                </div>
                <div class="modal-footer">
                    <small class="text-muted me-auto">
                        <i class="bi bi-info-circle"></i> Tip: Use mouse wheel to zoom, click and drag to pan
                    </small>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
    <script src="https://cdn.plot.ly/plotly-2.26.0.min.js"></script>
    <script src="{% static 'analytical/js/sec_report_create_v2.js' %}"></script>
</body>
</html>
