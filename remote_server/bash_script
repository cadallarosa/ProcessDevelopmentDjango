#!/bin/bash
echo "======================================"
echo "🖥️  DETAILED PERFORMANCE REPORT"
echo "======================================"
echo "📅 $(date)"
echo ""
echo "📊 SYSTEM: $(hostname) | $(uname -r)"
echo "⏱️  Uptime:$(uptime -p)"
echo ""
echo "🔧 CPU USAGE:"
top -bn1 | head -5 | tail -3
echo ""
echo "💾 MEMORY:"
free -h
echo ""
echo "💿 DISK USAGE:"
df -h | grep -E '^Filesystem|^/dev/'
echo ""
echo "📈 LOAD AVERAGE: $(uptime | awk -F'load average:' '{print $2}')"
echo ""
echo "⚙️  TOP 5 CPU PROCESSES:"
ps aux --sort=-%cpu | head -6 | awk 'NR>1 {printf "  %-20s %5s%%\n", substr($11,1,20), $3}'
echo ""
echo "⚙️  TOP 5 MEMORY PROCESSES:"
ps aux --sort=-%mem | head -6 | awk 'NR>1 {printf "  %-20s %5s%%\n", substr($11,1,20), $4}'
echo ""
echo "🌐 NETWORK:"
echo "  Connections: $(ss -tun | tail -n +2 | wc -l) total"
echo "  Established: $(ss -tun | tail -n +2 | grep ESTAB | wc -l)"
echo "  Listening: $(ss -tln | tail -n +2 | wc -l)"
echo ""
echo "🚀 DJANGO STACK:"
for service in "runserver:Django" "celery.*worker:Celery Worker" "celery.*beat:Celery Beat" "server.js:Node.js"; do
    pattern="${service%%:*}"
    name="${service##*:}"
    if pid=$(pgrep -f "$pattern" | head -1); then
        echo "  ✅ $name (PID: $pid)"
    else
        echo "  ❌ $name"
    fi
done
echo ""
echo "🔌 PORTS:"
for port in 8000 3000 5432 6379; do
    ss -tln | grep -q ":$port " && echo "  ✅ Port $port: Open" || echo "  ❌ Port $port: Closed"
done
echo "======================================"
EOF