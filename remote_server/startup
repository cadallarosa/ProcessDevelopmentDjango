echo "🚀 Starting Django Stack..."

# Kill any existing processes on ports 8080 and 3000
sudo pkill -f "runserver 0.0.0.0:8080" 2>/dev/null
sudo pkill -f "server.js" 2>/dev/null
sudo pkill -f "celery.*worker" 2>/dev/null
sudo pkill -f "celery.*beat" 2>/dev/null

# Start Django in background
cd /home/cdallarosa/home/cdallarosa/PycharmProjects && \
source .venv/.venv/bin/activate && \
python manage.py runserver 0.0.0.0:8080 > django.log 2>&1 &
DJANGO_PID=$!

# Start Node.js server in background
cd /home/cdallarosa/home/cdallarosa/PycharmProjects/plotly_integration/process_development/downstream_processing/akta/opcua_server/opcua-browser && \
/home/cdallarosa/.config/JetBrains/PyCharm2025.1/node/versions/22.15.1/bin/node server.js > nodejs.log 2>&1 &
NODEJS_PID=$!

# Start Celery worker in background
cd /home/cdallarosa/home/cdallarosa/PycharmProjects && \
source .venv/.venv/bin/activate && \
celery -A djangoProject worker --loglevel=info > celery-worker.log 2>&1 &
CELERY_WORKER_PID=$!

# Start Celery beat in background
cd /home/cdallarosa/home/cdallarosa/PycharmProjects && \
source .venv/.venv/bin/activate && \
celery -A djangoProject beat --loglevel=info > celery-beat.log 2>&1 &
CELERY_BEAT_PID=$!

# Wait a moment for services to start
sleep 3

# Check if services are running
echo "📊 Service Status:"
if kill -0 $DJANGO_PID 2>/dev/null; then echo "✅ Django running (PID: $DJANGO_PID)"; else echo "❌ Django failed"; fi
if kill -0 $NODEJS_PID 2>/dev/null; then echo "✅ Node.js running (PID: $NODEJS_PID)"; else echo "❌ Node.js failed"; fi
if kill -0 $CELERY_WORKER_PID 2>/dev/null; then echo "✅ Celery Worker running (PID: $CELERY_WORKER_PID)"; else echo "❌ Celery Worker failed"; fi
if kill -0 $CELERY_BEAT_PID 2>/dev/null; then echo "✅ Celery Beat running (PID: $CELERY_BEAT_PID)"; else echo "❌ Celery Beat failed"; fi

# Test ports
echo "🔌 Port Status:"
curl -s -o /dev/null -w "Django (8080): %{http_code}\n" http://localhost:8080 || echo "Django (8080): No response"
curl -s -o /dev/null -w "Node.js (3000): %{http_code}\n" http://localhost:3000 || echo "Node.js (3000): No response"

echo "🎯 All services started! Logs saved to: django.log, nodejs.log, celery-worker.log, celery-beat.log"